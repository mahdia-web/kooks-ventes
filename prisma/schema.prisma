// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Vente individuelle - ligne d'un bon de livraison (BL)
model Sale {
  id           String   @id @default(cuid())
  // N° BL unique - sert de clé d'import pour éviter les doublons
  blNumber     String
  date         DateTime
  enseigne     String
  type         String   // "Direct" ou "Centrale"
  agent        String
  amountHT     Float
  amountTTC    Float
  rate         Float    // taux de commission (0.07 ou 0.05)
  commission   Float
  month        Int     // 1-12
  year         Int     // ex 2025
  createdAt    DateTime @default(now())

  // Un N° BL ne devrait apparaître qu'une fois par agent/enseigne
  @@unique([blNumber])
  @@index([year, month])
  @@index([agent])
  @@index([enseigne])
  @@index([date])
}

// Enseigne / client - liste de référence (cache de la table ENSEIGNES)
model Enseigne {
  id           String   @id @default(cuid())
  name         String   @unique
  type         String   // "Direct" ou "Centrale"
  agent        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agent])
  @@index([type])
}

// Paramètre global (mois courant, année courante, taux par défaut)
model Parameter {
  key    String   @id
  value  String
  updatedAt DateTime @updatedAt
}
